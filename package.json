{
  "name": "notes-viewer",
  "productName": "Notes Viewer",
  "version": "3.0.0",
  "description": "Markdown notes reader and editor for studying: quizzes, Pomodoro, unresolved list, study heatmap.",
  "author": "Levan D",
  "private": true,
  "type": "module",
  "main": "main.js",
  "scripts": {
    "build:renderer": "esbuild --bundle --minify --format=iife --target=chrome130 --jsx=automatic src/main.tsx --outfile=renderer.bundle.js && esbuild --bundle --minify --format=iife --target=chrome130 src/mermaid-entry.ts --outfile=mermaid.bundle.js --log-level=warning && esbuild --bundle --minify --format=iife --target=chrome130 src/emoji-entry.ts --outfile=emoji.bundle.js --log-level=warning",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "test:e2e": "npm run build:renderer && playwright test",
    "start": "npm run build:renderer && electron .",
    "dist": "npm run typecheck && npm test && npm run build:renderer && electron-builder --win",
    "icon": "electron scripts/make-icon.mjs",
    "quiz": "node scripts/quiz.mjs"
  },
  "dependencies": {
    "highlight.js": "11.12.0",
    "katex": "0.18.11",
    "marked": "18.1.1",
    "marked-highlight": "2.2.4",
    "marked-katex-extension": "5.1.13"
  },
  "devDependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/language-data": "6.5.2",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@emoji-mart/data": "1.2.1",
    "@lezer/highlight": "1.2.5",
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.5",
    "codemirror": "6.0.2",
    "electron": "44.8.0",
    "electron-builder": "26.15.3",
    "emoji-mart": "5.6.0",
    "esbuild": "0.28.2",
    "jsdom": "30.1.3",
    "mermaid": "12.2.0",
    "minisearch": "7.2.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "zustand": "5.0.16"
  },
  "build": {
    "appId": "local.notes-viewer",
    "productName": "Notes Viewer",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "quiz-format.js",
      "quiz-gen.js",
      "preload.cjs",
      "index.html",
      "renderer.bundle.js",
      "mermaid.bundle.js",
      "emoji.bundle.js",
      "style.css",
      "assets/icon.png",
      "package.json",
      "!**/node_modules/**/*.{md,d.ts,map,umd.js}",
      "!**/node_modules/**/{bin,man}/**"
    ],
    "electronLanguages": [
      "en-US"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.png"
    },
    "portable": {
      "artifactName": "NotesViewer-${version}-portable.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Notes Viewer",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "NotesViewer-${version}-setup.exe"
    },
    "publish": null
  }
}
